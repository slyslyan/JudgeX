# JudgeX — Environment Configuration
# Copy this file to .env and adjust values for your deployment.

# Server
SERVER_PORT=8080

# MySQL
DB_HOST=mysql
DB_PORT=3306
DB_USER=judgex
DB_PASSWORD=judgex123
DB_NAME=judgex

# Redis
REDIS_ADDR=redis:6379

# NSQ (judge task queue)
NSQD_ADDR=nsqd:4150

# JWT — CHANGE THIS in production!
JWT_SECRET=judgex-secret-change-in-production

# Test data storage path (inside backend container)
TEST_DATA_PATH=/data/testcases

# Default admin password — CHANGE THIS in production!
ADMIN_PASSWORD=adminadmin

# Structured logging: debug, info, warn, error
LOG_LEVEL=info

# LLM / AI (optional — AI features disabled if unset)
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
